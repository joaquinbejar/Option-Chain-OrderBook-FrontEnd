{
	"name": "option-chain-orderbook-frontend",
	"version": "0.1.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"validate": "npm run check && npm run lint && npm run format:check && npm run test && npm run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0",
		"@sveltejs/adapter-auto": "^7.0",
		"@sveltejs/adapter-node": "^5.5",
		"@sveltejs/kit": "^2.70",
		"@sveltejs/vite-plugin-svelte": "^7.3",
		"@tailwindcss/vite": "^4.3",
		"@testing-library/jest-dom": "^7.0",
		"@testing-library/svelte": "^5.4",
		"@types/node": "^26.6",
		"@vitest/coverage-v8": "^5.0",
		"eslint": "^10.10",
		"eslint-config-prettier": "^10.1",
		"eslint-plugin-svelte": "^3.23",
		"globals": "^17.12",
		"jsdom": "^30.1",
		"prettier": "^3.9",
		"prettier-plugin-svelte": "^4.1",
		"svelte": "^5.57",
		"svelte-check": "^4.7",
		"tailwindcss": "^4.3",
		"typescript": "^6.0",
		"typescript-eslint": "^8.70",
		"vite": "^8.3",
		"vitest": "^5.0"
	},
	"type": "module"
}
